{
  "name": "pi-splash-server",
  "version": "0.1.4",
  "description": "Run a local Splash server from Pi, with the model and flags picked for your Mac (M1/M2 via splash-m1)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sady4850/pi-splash-server.git"
  },
  "homepage": "https://github.com/sady4850/pi-splash-server#readme",
  "bugs": {
    "url": "https://github.com/sady4850/pi-splash-server/issues"
  },
  "keywords": [
    "pi-package",
    "omp",
    "oh-my-pi",
    "splash",
    "apple-silicon",
    "local-llm",
    "mlx",
    "gguf"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "pi": {
    "extensions": [
      "./extensions/splash.ts"
    ],
    "image": "https://raw.githubusercontent.com/sady4850/pi-splash-server/main/media/screenshot.png"
  },
  "omp": {
    "extensions": [
      "./extensions/splash.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "extensions",
    "src",
    "data",
    "README.md",
    "LICENSE"
  ]
}
